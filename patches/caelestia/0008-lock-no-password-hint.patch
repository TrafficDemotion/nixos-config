锁屏密码框：去掉常驻提示「Enter your password」

为什么只能打补丁：锁屏文案全部走 Tr.tr()，而语言目录（*.mo）在构建时被编译进
caelestia-qml-plugin 的 Qt 资源里（translator.cpp 的 resourceDir() = ":/qt/qml/Caelestia/I18n/"，
整机 /nix/store 下一个 .mo 都找不到），`general.language`（Nexus → Language & region）
只能在这些已编译的目录之间选，无法覆盖单条文案；lock 的配置项
（lockconfig.hpp：enabled/useWallpaper/recolourLogo/enableFprint/maxFprintTries/enableHowdy/
maxHowdyTries/triggerHowdyOnWake/hideNotifs）也不含任何文案开关。

改法（modules/lock/center/InputField.qml）：把那段文字抽成 hintText —— **显示**用它、
**度量**（nonAnimPlaceholder）在它为空时退回原提示词宽度。度量不能一起清掉：
PasswordInput.qml:20 在 buffer 为空时用 inputField.placeholderWidth 决定密码框空态宽度，
只清显示不清度量会让密码框在输入前缩成「锁图标 + 箭头按钮」那么窄，一打字又弹回 0.8*centerWidth。
瞬时状态（Loading… / Scanning face… / Max tries reached）保留显示。

--- a/modules/lock/center/InputField.qml
+++ b/modules/lock/center/InputField.qml
@@ -45,18 +45,27 @@
         target: root.pam
     }
 
+    // 本地补丁 0008（2026-09-13 用户要求）：常驻提示「Enter your password」不再显示。
+    // 关键点：**只去掉显示，不改度量** —— PasswordInput.qml 的 implicitWidth 在 buffer 为空时用
+    // inputField.placeholderWidth（= nonAnimPlaceholder.width）决定空态宽度，直接清空度量会让
+    // 密码框在输入前缩成「锁图标 + 箭头按钮」那么窄，一打字又弹回 0.8*centerWidth。
+    // 所以把这段文字抽成 hintText：显示用它，度量在它为空时退回原提示词的宽度。
+    // 瞬时状态（Loading… / Scanning face… / Max tries reached）照旧显示，只有常驻提示被去掉。
+    readonly property string hintText: {
+        if (root.pam.passwd.active)
+            return Tr.tr("Loading...");
+        if (root.pam.howdy.active)
+            return Tr.tr("Scanning face...");
+        if (root.pam.state === Pam.MaxTries)
+            return Tr.tr("Max tries reached");
+        return "";
+    }
+
     TextMetrics {
         id: nonAnimPlaceholder
 
-        text: {
-            if (root.pam.passwd.active)
-                return Tr.tr("Loading...");
-            if (root.pam.howdy.active)
-                return Tr.tr("Scanning face...");
-            if (root.pam.state === Pam.MaxTries)
-                return Tr.tr("Max tries reached");
-            return Tr.tr("Enter your password");
-        }
+        // 只用于量宽：hintText 为空时按原提示词量，空态宽度与打补丁前保持一致。
+        text: root.hintText.length > 0 ? root.hintText : Tr.tr("Enter your password")
         font: placeholder.font
     }
 
@@ -66,7 +75,7 @@
         anchors.centerIn: parent
         anchors.verticalCenterOffset: 1
 
-        text: nonAnimPlaceholder.text
+        text: root.hintText
 
         animate: true
         color: root.pam.passwd.active ? Colours.palette.m3secondary : Colours.palette.m3outline
