diff --git a/modules/launcher/items/EmojiItem.qml b/modules/launcher/items/EmojiItem.qml
new file mode 100644
index 0000000..3d0852f
--- /dev/null
+++ b/modules/launcher/items/EmojiItem.qml
@@ -0,0 +1,54 @@
+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// emoji 的一行：字形本身要用普通文本画（ActionItem 的 MaterialIcon 只吃图标字体），
+// 右边跟一串关键词。
+Item {
+    id: root
+
+    required property var modelData
+    required property var list
+
+    implicitHeight: Tokens.sizes.launcher.itemHeight
+
+    anchors.left: parent?.left
+    anchors.right: parent?.right
+
+    StateLayer {
+        radius: Tokens.rounding.large
+        onClicked: root.modelData?.onClicked(root.list)
+    }
+
+    Item {
+        anchors.fill: parent
+        anchors.leftMargin: Tokens.padding.medium
+        anchors.rightMargin: Tokens.padding.medium
+        anchors.margins: Tokens.padding.small
+
+        StyledText {
+            id: glyph
+
+            anchors.verticalCenter: parent.verticalCenter
+
+            text: root.modelData?.glyph ?? ""
+            font: Tokens.font.body.builders.large.build()
+        }
+
+        StyledText {
+            id: keywords
+
+            anchors.left: glyph.right
+            anchors.leftMargin: Tokens.spacing.medium
+            anchors.verticalCenter: glyph.verticalCenter
+
+            text: root.modelData?.name ?? ""
+            font: Tokens.font.body.small
+            color: Colours.palette.m3outline
+
+            elide: Text.ElideRight
+            width: root.width - glyph.width - Tokens.rounding.extraLargeIncreased
+        }
+    }
+}
diff --git a/modules/launcher/services/Clipboard.qml b/modules/launcher/services/Clipboard.qml
new file mode 100644
index 0000000..d43b5f2
--- /dev/null
+++ b/modules/launcher/services/Clipboard.qml
@@ -0,0 +1,134 @@
+// 剪贴板历史来源（Super+V 的「外壳内」版本）
+//
+// 数据源与 `caelestia clipboard` 命令完全相同：cliphist 的历史库。
+// 区别只是把列表画在启动器里（跟外壳同一套组件/配色），而不是弹一个 fuzzel 窗口。
+// 输入 `>clipboard ` 也能进同一个状态（走 AppList.stateForText 的前缀逻辑）。
+//
+// cliphist list 每行形如 "<id>\t<base64 预览>"；选中某行时把它原样喂给
+// `cliphist decode`（这才是 cliphist 的官方用法），再把解码结果交给 wl-copy。
+pragma Singleton
+
+import ".."
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Caelestia.Config
+import qs.utils
+
+Searcher {
+    id: root
+
+    // cliphist list 的原始行
+    property var rawLines: []
+
+    function reload(): void {
+        fetch.running = true;
+    }
+
+    function transformSearch(search: string): string {
+        const prefix = `${GlobalConfig.launcher.actionPrefix}clipboard `;
+        return search.startsWith(prefix) ? search.slice(prefix.length) : search;
+    }
+
+    function selector(item: var): string {
+        return item.name;
+    }
+
+    // cliphist 的预览本身就是可读文本（二进制条目是 "[[ binary data … ]]" 这类标记），
+    // 所以这里只取 tab 之后的部分，**不要**再 base64 解码 —— 它输出的不是 base64，
+    // 解码会把正常文字变成乱码（踩过）。
+    function preview(line: string): string {
+        return line.slice(line.indexOf("\t") + 1).trim();
+    }
+
+    // 二进制条目（图片等）的预览是 "[[ binary data 1 MiB png 2560x1440 ]]" 这种标记，
+    // 从中取出类型 → 复制时要用 wl-copy --type image/png，否则图片会被当成文本贴出去。
+    function mimeOf(line: string): string {
+        const m = /^\[\[ binary data .*? ([a-z0-9]+) \d+x\d+ \]\]$/.exec(preview(line));
+        if (!m)
+            return "";
+        const ext = m[1];
+        return `image/${ext === "jpg" ? "jpeg" : ext}`;
+    }
+
+    list: entries.instances
+    useFuzzy: true
+    keys: ["name"]
+    weights: [1]
+
+    Variants {
+        id: entries
+
+        model: root.rawLines
+        Clip {}
+    }
+
+    component Clip: QtObject {
+        required property var modelData
+
+        readonly property string mime: root.mimeOf(modelData)
+        readonly property string name: root.preview(modelData)
+        readonly property string desc: ""
+        readonly property string icon: mime === "" ? "content_paste" : "image"
+
+        function onClicked(list: AppList): void {
+            // ⚠️ 顺序：**先复制，再关启动器**（2026-09-16 定案，用户真机验证）
+            // 应用只有在**重新拿到键盘焦点**时才会收到新的 selection，而启动器关闭正是应用
+            // 拿回焦点的那一刻。先关面板再复制 → 那次焦点事件发生在选区之前，应用永远读不到
+            // 新内容（表现：点条目后粘不出来，必须再手动点一下窗口才能粘）；先复制再关就正常。
+            // IPC 对照实验已确认（无启动器 vs 启动器开着时复制再关闭），与谁 fork wl-copy 无关。
+            // 另外两条也不能违反：不能 write() 进 stdin；挂选区交给 Hyprland 起（本机 Lua 配置）。
+            root.copyToClipboard(modelData, mime);
+            closeTimer.target = list;
+            closeTimer.restart();
+        }
+    }
+
+    // 复制完再关启动器（顺序原因见 Clip.onClicked 的注释）；500ms 是留给复制落地的时间。
+    Timer {
+        id: closeTimer
+
+        property var target: null
+
+        interval: 250
+        onTriggered: {
+            if (target)
+                target.screenState.launcher = false;
+        }
+    }
+
+    // 真正的复制动作：外壳只往 /tmp 写「选中的行」+ 一个内容固定的 helper，
+    // 挂选区那步让 Hyprland 起（见 onClicked 注释 3）。
+    function copyToClipboard(line: string, mime: string): void {
+        const tmp = `/tmp/caelestia-clip-${Date.now()}`;
+        const helper = `${tmp}.sh`;
+        const type = mime === "" ? "" : ` --type ${mime}`;
+        const cmd = [
+            `printf '%s\\n' "$1" > ${tmp}`,
+            `printf '%s\\n' 'i=0; while [ ! -e ${tmp} ] && [ $i -lt 250 ]; do i=$((i+1)); sleep 0.02; done' 'cliphist decode < ${tmp} | wl-copy${type}' 'rm -f ${tmp} ${helper}' > ${helper}`,
+            // SIG 优先取外壳环境里的（Hyprland 注入的，一定是活的）；$XDG_RUNTIME_DIR/hypr/ 下
+            // 会残留历史会话的目录，head -1 可能挑到过期的那个（连不上、静默失败）。
+            `SIG=\${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -dt "$XDG_RUNTIME_DIR"/hypr/*/ 2>/dev/null | head -1 | xargs -r basename)}`,
+            `HYPRLAND_INSTANCE_SIGNATURE=$SIG hyprctl dispatch "hl.dsp.exec_cmd(\\"sh ${helper}\\")"`
+        ].join("\n");
+        Quickshell.execDetached(["sh", "-c", cmd, "hermes", line]);
+    }
+
+    Process {
+        id: fetch
+
+        command: ["cliphist", "list"]
+        stdout: StdioCollector {
+            // 保持 cliphist 的原生顺序（新→旧）：面板是从上往下渲染的，第一项就在最上面。
+            // 「打开时滚到最上面」由 AppList.qml 在 launcher 打开时显式做（见那里的注释）。
+            onStreamFinished: root.rawLines = text.split("\n").filter(line => line.includes("\t"))
+        }
+    }
+
+    LoggingCategory {
+        id: lc
+
+        name: "caelestia.qml.launcher.clipboard"
+        defaultLogLevel: LoggingCategory.Warning
+    }
+}
diff --git a/modules/launcher/services/Emojis.qml b/modules/launcher/services/Emojis.qml
new file mode 100644
index 0000000..cc91700
--- /dev/null
+++ b/modules/launcher/services/Emojis.qml
@@ -0,0 +1,98 @@
+// emoji 选择器来源（Super+. 的「外壳内」版本）
+//
+// 数据来自 `caelestia emoji`（不带 -p 时它直接把内置的 emojis.txt 打到 stdout，
+// 每行 "<字形> 空格分隔的关键词"），选中后把字形交给 wl-copy —— 与
+// `caelestia emoji -p` 的行为一致，只是列表换成了启动器自己画。
+// 输入 `>emoji ` 也能进同一个状态。
+pragma Singleton
+
+import ".."
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Caelestia.Config
+import qs.utils
+
+Searcher {
+    id: root
+
+    // `caelestia emoji` 输出的原始行
+    property var rawLines: []
+
+    function reload(): void {
+        if (root.rawLines.length === 0)
+            fetch.running = true;
+    }
+
+    function transformSearch(search: string): string {
+        const prefix = `${GlobalConfig.launcher.actionPrefix}emoji `;
+        return search.startsWith(prefix) ? search.slice(prefix.length) : search;
+    }
+
+    function selector(item: var): string {
+        return item.name;
+    }
+
+    list: entries.instances
+    useFuzzy: true
+    keys: ["name"]
+    weights: [1]
+
+    Variants {
+        id: entries
+
+        model: root.rawLines
+        Emoji {}
+    }
+
+    component Emoji: QtObject {
+        required property var modelData
+
+        readonly property string glyph: modelData.split(" ")[0] ?? ""
+        readonly property string name: modelData.slice(glyph.length).trim()
+        readonly property string desc: ""
+
+        function onClicked(list: AppList): void {
+            // 与 Clipboard.qml 同样的坑：不能 write() stdin、**必须先复制再关面板**
+            // （应用是在启动器关闭、自己拿回焦点时才收到新 selection 的）。
+            root.copyEmoji(glyph);
+            closeTimer.target = list;
+            closeTimer.restart();
+        }
+    }
+
+    // 复制完再关启动器（顺序原因见 Clipboard.qml 的注释）
+    Timer {
+        id: closeTimer
+
+        property var target: null
+
+        interval: 250
+        onTriggered: {
+            if (target)
+                target.screenState.launcher = false;
+        }
+    }
+
+    // 外壳只写文件，挂选区交给 Hyprland（见 Clipboard.qml 注释 3）
+    function copyEmoji(glyph: string): void {
+        const tmp = `/tmp/caelestia-emoji-${Date.now()}`;
+        const helper = `${tmp}.sh`;
+        const cmd = [
+            `printf '%s' "$1" > ${tmp}`,
+            `printf '%s\\n' 'i=0; while [ ! -e ${tmp} ] && [ $i -lt 250 ]; do i=$((i+1)); sleep 0.02; done' 'wl-copy < ${tmp}' 'rm -f ${tmp} ${helper}' > ${helper}`,
+            `SIG=\${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -dt "$XDG_RUNTIME_DIR"/hypr/*/ 2>/dev/null | head -1 | xargs -r basename)}`,
+            `HYPRLAND_INSTANCE_SIGNATURE=$SIG hyprctl dispatch "hl.dsp.exec_cmd(\\"sh ${helper}\\")"`
+        ].join("\n");
+        Quickshell.execDetached(["sh", "-c", cmd, "hermes", glyph]);
+    }
+
+    Process {
+        id: fetch
+
+        command: ["caelestia", "emoji"]
+        stdout: StdioCollector {
+            onStreamFinished: root.rawLines = text.split("\n").filter(line => line.trim() !== "")
+        }
+    }
+}
