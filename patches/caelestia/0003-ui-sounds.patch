--- /dev/null
+++ b/services/UiSounds.qml
@@ -0,0 +1,47 @@
+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+
+Singleton {
+    id: root
+
+    // ── 本地补丁（patches/caelestia/0003-ui-sounds.patch）────────────────────────
+    // Caelestia 外壳自己没有音效接口，这里给交互点补上：所有走 StateLayer 的点击、
+    // StyledSwitch 的开关、两类滑条的拖动、CustomMouseArea 的滚轮、dashboard 切标签。
+    // 播放仍是「每条音起一个 pw-play 进程」≈100–140ms 起流延迟（与 Hyprland 事件那套
+    // 同一代价）；想更快得在壳内解码播放（QtMultimedia），见 README。
+    // 素材在 ~/.local/share/sfx/（由 home.nix 的 xdg.dataFile 声明）。
+    // 关掉：enabled = false。
+    property bool enabled: true
+    readonly property string dir: `${Quickshell.env("HOME")}/.local/share/sfx/`
+
+    // 同一文件的最小间隔（毫秒）——拖动/连点时别糊成一片
+    property var lastPlayed: ({})
+
+    function play(file: string, minInterval: int): void {
+        if (!enabled)
+            return;
+        const now = Date.now();
+        if (now - (lastPlayed[file] ?? 0) < minInterval)
+            return;
+        lastPlayed[file] = now;
+        Quickshell.execDetached(["pw-play", dir + file]);
+    }
+
+    // 通用点击：按钮 / 列表条目 / 栏上图标 / tile / 启动器条目 …
+    function click(): void {
+        play("ui-click.wav", 40);
+    }
+
+    // 开关类（StyledSwitch）：开=高一点、关=低一点
+    function toggle(on: bool): void {
+        play(on ? "ui-toggle-on.wav" : "ui-toggle-off.wav", 60);
+    }
+
+    // 滑条拖动 / 滚轮调节（音量、亮度、工作区、日历翻页…）
+    function slider(): void {
+        play("ui-scroll.wav", 90);
+    }
+}
