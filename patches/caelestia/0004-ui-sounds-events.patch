UI 交互音效（QML 补丁 2/2）：把原来挂在 Hyprland Lua 上的音效搬进外壳

接续 0003（组件级点击/开关/滑条/滚轮），这一张把「事件级」的也搬过来：
  services/Hypr.qml          window.open/close（toplevels 模型增删）+ workspace.active
  components/ScreenState.qml 抽屉/面板开合（launcher/dashboard/session/sidebar/utilities/osd）
  modules/areapicker/AreaPicker.qml  截图快门（8 个入口共用 activeAsync）
  modules/lock/Lock.qml      锁屏 + 解锁（解锁在 Lua 那套里无事件可挂）
  services/Recorder.qml      录屏开始/结束
并给 UiSounds 加 playIfQuiet()：面板开合紧跟一次点击音时，250ms 内不再重复出声。
--- a/services/UiSounds.qml
+++ b/services/UiSounds.qml
@@ -22,6 +22,9 @@
     // 同一文件的最小间隔（毫秒）——拖动/连点时别糊成一片
     property var lastPlayed: ({})
 
+    // 任何一条音最后响的时刻——用于「刚响过就别再响」
+    property real lastAny: 0
+
     function play(file: string, minInterval: int): void {
         if (!enabled)
             return;
@@ -29,7 +32,15 @@
         if (now - (lastPlayed[file] ?? 0) < minInterval)
             return;
         lastPlayed[file] = now;
+        lastAny = now;
         Quickshell.execDetached(["pw-play", dir + file]);
+    }
+
+    // 面板开合常常紧跟着一次点击音 → 250ms 内已经响过就跳过，免得一次操作听成两声
+    function playIfQuiet(file: string, minInterval: int, quietMs: int): void {
+        if (!enabled || Date.now() - lastAny < quietMs)
+            return;
+        play(file, minInterval);
     }
 
     // 通用点击：按钮 / 列表条目 / 栏上图标 / tile / 启动器条目 …
@@ -46,4 +57,34 @@
     function slider(): void {
         play("ui-scroll.wav", 90);
     }
