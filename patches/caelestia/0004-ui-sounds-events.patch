+    function shutter(): void {
+        play("camera-shutter.wav", 300);
+    }
+
+    function lockState(on: bool): void {
+        play(on ? "lock.wav" : "unlock.wav", 400);
+    }
+
+    function record(on: bool): void {
+        play(on ? "video-record.wav" : "video-stop.wav", 400);
+    }
