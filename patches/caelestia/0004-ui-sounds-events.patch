--- a/services/Hypr.qml
+++ b/services/Hypr.qml
@@ -212,4 +212,34 @@
 
         usingLua: Hyprland.usingLua
     }
+
+    // ── 本地补丁：窗口/工作区音效（原来挂在 Hyprland 的 Lua 上，2026-09-13 搬进外壳）──
+    // Hyprland.toplevels 是 UntypedObjectModel：新窗口 → objectInsertedPost，关窗 → objectRemovedPre。
+    // soundsReady 用来吃掉「外壳刚启动时对已有窗口」的那一批事件（否则一开就响一串）。
+    property bool soundsReady: false
+
+    Timer {
+        interval: 2000
+        running: true
+        onTriggered: root.soundsReady = true
+    }
+
+    onFocusedWorkspaceChanged: {
+        if (soundsReady)
+            UiSounds.workspace();
+    }
+
+    Connections {
+        target: Hyprland.toplevels
+
+        function onObjectInsertedPost(): void {
+            if (root.soundsReady)
+                UiSounds.windowOpen();
+        }
+
+        function onObjectRemovedPre(): void {
+            if (root.soundsReady)
+                UiSounds.windowClose();
+        }
+    }
 }
