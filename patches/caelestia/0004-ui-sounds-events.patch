+    // ── 事件类：窗口 / 工作区 / 面板 / 截图 / 锁屏 / 录屏 ──────────────────────
+    // 这些原来挂在 Hyprland 的 Lua 上（2026-09-13 搬进外壳，见 patches/caelestia/0004）
+    function windowOpen(): void {
+        play("window-open.wav", 40);
+    }
