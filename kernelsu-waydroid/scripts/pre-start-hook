#!/run/current-system/sw/bin/bash
set -euo pipefail

log() {
    logger -t kernelsu-waydroid-pre-start -- "$*" 2>/dev/null || true
}

state_dir=/run/kernelsu-next-waydroid
state_file=$state_dir/lifecycle.state
lock_file=/run/kernelsu-waydroid-module.lock

read_state() {
    local state

    if [[ -r $state_file ]]; then
        IFS= read -r state < "$state_file" || true
        printf '%s' "${state:-invalid}"
    else
        printf 'unknown'
    fi
}

mark_start_failed() {
    local status=$?
    printf 'stop-failed\n' > "$state_file"
    log "start failed at line ${BASH_LINENO[0]} with status ${status}"
    exit "$status"
}

# lxc.hook.pre-start runs before Android init exists. A teardown queued by
# lxc.hook.post-stop runs asynchronously (oneshot + timer, ~2-4s), so an
# Android-initiated restart asks for the next start while lifecycle is still
# stop-pending. Refusing there strands the container for good: Waydroid does not
# retry a failed lxc-start. So wait for the lifecycle to settle instead.
mkdir -p -m 0755 "$state_dir"
trap mark_start_failed ERR

# Never hold the lock while waiting: the unload script takes the same flock to
# make progress, so holding it would starve the teardown. Budget matters —
# Waydroid only waits ~10s for the container to reach RUNNING
# (tools/helpers/lxc.py wait_for_running) and loading the module costs ~1s.
wait_deadline=$((SECONDS + 6))
lock_busy=0
wait_logged=0
while :; do
    lock_busy=0
    if exec 9>"$lock_file" && flock -n 9; then
        state=$(read_state)
        case $state in
            unloaded|unknown)
                break
                ;;
            stop-pending|unhook-pending|unload-pending)
                # Teardown already reached its goal; only its bookkeeping lags.
                if ! grep -q '^kernelsu ' /proc/modules; then
                    log "module already unloaded while lifecycle is ${state}; starting anyway"
                    break
                fi
                if (( ! wait_logged )); then
                    log "lifecycle is ${state}; waiting for teardown to finish"
                    wait_logged=1
                fi
                ;;
            stop-failed|starting|running)
                ;;
            *)
                echo "${0##*/}: invalid lifecycle state: ${state}" >&2
                log "start refused because lifecycle state is invalid: ${state}"
                exit 6
                ;;
        esac
        exec 9>&-    # release before sleeping so the unload script can finish
    else
        lock_busy=1
    fi

    if ((SECONDS >= wait_deadline)); then
        state=$(read_state)
        echo "${0##*/}: lifecycle is ${state}; start refused until UNLOADED" >&2
        log "start refused while lifecycle is ${state}"
        if ((lock_busy)); then
            exit 4
        fi
        exit 5
    fi
    sleep 0.25
done

printf 'starting\n' > "$state_file"

/usr/lib/kernelsu-next-waydroid/sync-brene-uts
/usr/lib/kernelsu-next-waydroid/configure-osrelease validate

if grep -q '^kernelsu ' /proc/modules; then
    log "KernelSU is already loaded before Waydroid init"
    /usr/lib/kernelsu-next-waydroid/configure-osrelease apply
else
    log "loading KernelSU before Waydroid init"
    timeout --signal=TERM --kill-after=5s 30s \
        /usr/lib/kernelsu-next-waydroid/load-module
fi

if ! grep -q '^kernelsu ' /proc/modules; then
    printf 'stop-failed\n' > "$state_file"
    echo "${0##*/}: kernelsu module is not loaded" >&2
    exit 1
fi

printf 'running\n' > "$state_file"
log "KernelSU is ready for Waydroid init"
