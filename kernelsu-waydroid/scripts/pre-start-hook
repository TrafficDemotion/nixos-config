#!/run/current-system/sw/bin/bash
set -euo pipefail

log() {
    logger -t kernelsu-waydroid-pre-start -- "$*" 2>/dev/null || true
}

state_dir=/run/kernelsu-next-waydroid
state_file=$state_dir/lifecycle.state
lock_file=/run/kernelsu-waydroid-module.lock

read_state() {
    local state

    if [[ -r $state_file ]]; then
        IFS= read -r state < "$state_file" || true
        printf '%s' "${state:-invalid}"
    else
        printf 'unknown'
    fi
}

mark_start_failed() {
    local status=$?
    printf 'stop-failed\n' > "$state_file"
    log "start failed at line ${BASH_LINENO[0]} with status ${status}"
    exit "$status"
}

# lxc.hook.pre-start runs before Android init exists, and Android needs KernelSU
# loaded before its init runs. A transition can be pending here for two reasons,
# and they need opposite handling:
#
#   * a teardown queued by lxc.hook.post-stop. It can NEVER complete while this
#     start is alive: the unload script requires LXC to be STOPPED *and* no
#     lxc-start process, and this hook is itself a child of lxc-start. Waiting for
#     it is a deadlock — an Android-initiated restart asks for the next start in
#     the same second as the stop (tools/services/hardware_manager.py
#     shutdownRequest), and the queued unload only ever ran after our exit.
#     So when the loaded module is still armed, keep it and continue: the module
#     finds /system/bin/init dynamically and the reuse path (sync-brene-uts +
#     configure-osrelease apply) is the per-session setup. The queued unload then
#     observes a non-pending state and no-ops.
#   * a real detach (prepare_unload == Y): that module is half torn down, so it can
#     neither be reused nor have a fresh one loaded on top. Wait (bounded) for the
#     unload to finish; Waydroid only gives the container ~10s to reach RUNNING
#     (tools/helpers/lxc.py wait_for_running) and loading costs ~1s.
#
# Only the lock is shared with the unload script, and it is never held while
# waiting — holding it would starve the very teardown we are waiting for.
mkdir -p -m 0755 "$state_dir"
trap mark_start_failed ERR

prepare_unload=/sys/module/kernelsu/parameters/prepare_unload

module_loaded() {
    grep -q '^kernelsu ' /proc/modules
}

module_armed() {
    [[ -r $prepare_unload ]] && [[ $(<"$prepare_unload") != Y ]]
}

wait_deadline=$((SECONDS + 6))
lock_busy=0
wait_logged=0
while :; do
    lock_busy=0
    if exec 9>"$lock_file" && flock -n 9; then
        state=$(read_state)
        case $state in
            unloaded|unknown)
                break
                ;;
            stop-pending|unhook-pending|unload-pending|stop-failed|starting|running)
                if ! module_loaded; then
                    log "module already gone while lifecycle is ${state}; loading fresh"
                    break
                fi
                if module_armed; then
                    log "lifecycle is ${state} but the loaded module is armed and its teardown cannot run during a start; reusing it"
                    break
                fi
                if (( ! wait_logged )); then
                    log "lifecycle is ${state} and the module is mid-detach; waiting for teardown to finish"
                    wait_logged=1
                fi
                ;;
            *)
                echo "${0##*/}: invalid lifecycle state: ${state}" >&2
                log "start refused because lifecycle state is invalid: ${state}"
                exit 6
                ;;
        esac
        exec 9>&-    # release before sleeping so the unload script can finish
    else
        lock_busy=1
    fi

    if ((SECONDS >= wait_deadline)); then
        state=$(read_state)
        echo "${0##*/}: lifecycle is ${state}; start refused until UNLOADED" >&2
        log "start refused while lifecycle is ${state}"
        if ((lock_busy)); then
            exit 4
        fi
        exit 5
    fi
    sleep 0.25
done

printf 'starting\n' > "$state_file"

/usr/lib/kernelsu-next-waydroid/sync-brene-uts
/usr/lib/kernelsu-next-waydroid/configure-osrelease validate

if grep -q '^kernelsu ' /proc/modules; then
    log "KernelSU is already loaded before Waydroid init"
    /usr/lib/kernelsu-next-waydroid/configure-osrelease apply
else
    log "loading KernelSU before Waydroid init"
    timeout --signal=TERM --kill-after=5s 30s \
        /usr/lib/kernelsu-next-waydroid/load-module
fi

if ! grep -q '^kernelsu ' /proc/modules; then
    printf 'stop-failed\n' > "$state_file"
    echo "${0##*/}: kernelsu module is not loaded" >&2
    exit 1
fi

printf 'running\n' > "$state_file"
log "KernelSU is ready for Waydroid init"
