#!/usr/bin/env bash
# pre-push 闸门：拦截「密钥形态」的内容，别让它进公开仓库。
#
# 为什么用 hook：这个仓库是 public，push 出去就等于公开。命中时只中止本次 push，
# 本地提交原样保留，方便人工检查后删除文件 / 改写历史再推。
#
# 只匹配几乎不可能误报的形态；不看 diff 内容而是扫「本次推送涉及的文件的当前内容」。
# 安装（新克隆后要重新装，hooks 不入库）：
#   sudo install -m 755 /etc/nixos/git-hooks/pre-push /etc/nixos/.git/hooks/pre-push
set -uo pipefail

zero="0000000000000000000000000000000000000000"

patterns='-----BEGIN [A-Z ]*PRIVATE KEY-----'
patterns+='|gh[opsur]_[A-Za-z0-9]{36}'
patterns+='|github_pat_[A-Za-z0-9_]{22,}'
patterns+='|cfat_[A-Za-z0-9]{30,}'
patterns+='|AKIA[0-9A-Z]{16}'
patterns+='|AGE-SECRET-KEY-1'
# 注意：age1... 是 age 的「公钥」（收件人），公开无害，故意不拦。

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # 删除远程分支，没什么可扫

  if [ "$remote_sha" = "$zero" ]; then            # 新分支：整个树都算新内容
    range_args=("$local_sha")
    diff_args=()
  else
    range_args=("$remote_sha" "$local_sha")
    diff_args=("--diff-filter=ACMR")
  fi

  files=$(git diff --name-only "${diff_args[@]}" "${range_args[@]}" 2>/dev/null || true)
  # 闸门源文件必然逐字包含这些模式串，排除自身，免得自己锁自己
  files=$(printf '%s\n' $files | grep -vx 'git-hooks/pre-push' || true)
  [ -z "$files" ] && continue

  hits=$(git grep -nE -e "$patterns" "$local_sha" -- $files)
  grep_rc=$?
  if [ "$grep_rc" -gt 1 ]; then
    # git grep 自己出错（2）——不能当作「没命中」，保守拒绝
    printf '\n\033[1;31m✗ pre-push 中止：密钥扫描本身失败 (git grep rc=%s)，保守起见不推送\033[0m\n' "$grep_rc"
    blocked=1
    continue
  fi

  if [ -n "$hits" ]; then
    printf '\n\033[1;31m✗ pre-push 拦截：本次推送的文件里有密钥形态的内容\033[0m\n\n'
    printf '%s\n' "$hits"
    printf '\n\033[1;33m这个仓库是 public —— 清掉再推：\033[0m\n'
    printf '  1) 改掉/删掉上面文件里的密钥\n'
    printf '  2) sudo git -C /etc/nixos commit --amend    （或 git rebase -i 改写）\n'
    printf '  3) sudo git -C /etc/nixos push origin main\n'
    printf '确属误报：sudo git -C /etc/nixos push --no-verify origin main\n\n'
    blocked=1
  fi
done

[ "$blocked" = 1 ] && exit 1
exit 0
